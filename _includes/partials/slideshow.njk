<style>
  .slideshow-container {
    width: 100%;
    max-width: 800px;
    height: 450px;
    margin: 2rem auto;
    border-radius: 12px;
    overflow: hidden;
    /* box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12); */
    /* background: #f4f4f4; */
    /* Platzhalter-Farbe */
    position: relative;
  }

  .slideshow-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
</style>

<custom-slideshow class="slideshow-container">
  {% if gallery and gallery.length > 0 %}
  <img class="slideshow-image" src="{{ gallery[0] }}" alt="Slideshow Image">
  <script type="application/json">
    {{ gallery | dump | safe }}
  </script>
  {% else %}
  <p style="padding: 2rem; text-align: center;">Keine Bilder gefunden.</p>
  {% endif %}
</custom-slideshow>