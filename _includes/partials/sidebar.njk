
<div id="ect">
    <div class="gap"></div>

    <a href="/" id="ect-title" style="text-decoration: none; color: inherit;">
        {# {% icon "home" %} #}
        <h1>Exploring Creative Technologies</h1>
    </a>

    <div class="gap"></div>

    <ul class="allLists">
        <li class="aList aMocList" id="search">
            <div class="aListTitle">
                {% icon "chevron--right" %}
                <div>
                    <h3 id="aMocName"> Search</h3>
                    <input type="text" id="searchInput" placeholder="Search..." autocomplete="off">
                    {% icon "search" %}
                </div>
            </div>
            <ol class="listOfContent" style="display: none;">
                {% for post in collections.posts | sort(attribute="data.title") %}
                    {% set skip = false %}
                    {% if post.data.tags %}
                        {% if "moc" in post.data.tags or "private" in post.data.tags %}
                            {% set skip = true %}
                        {% endif %}
                    {% endif %}
                    
                    {% if not skip and post.url %}
                        <li class="contentLink">
                            {% icon "choose-item" %}
                            <a href="{{ post.url }}">{{ post.data.title or post.fileSlug }}</a>
                        </li>
                    {% endif %}
                {% endfor %}
            </ol>
        </li>

        <div class="gap"></div>

        {% for moc in collections.moc %}
        <li class="aList aMocList">
            <div class="aListTitle">
                {% icon "chevron--right" %}
                <div>
                    <h3 id="aMocName">{{ moc.data.title }}</h3>
                    {% icon "list--numbered" %}
                </div>
            </div>

            <ol class="listOfContent" style="display: none;">
                {{ moc.templateContent | linkClass | mocSidebar(collections.all) | safe }}
            </ol>
        </li>
        {% endfor %}

        <div class="gap"></div>

        {% for item in collections | sortTagsByCount %}
        {% set tag = item.tag %}
        {% set posts = item.posts %}
        <li class="aList aTagList">
            <div class="aListTitle">
                {% icon "chevron--right" %}
                <div>
                    <h3 id="aTagName">{{ tag | cleanTags }}</h3>
                    {% icon "list--bulleted" %}
                </div>
            </div>


            <ul class="listOfContent" style="display: none;">
                {% for post in posts %}
                <li class="contentLink">
                    {% icon "choose-item" %}

                    <a href="{{ post.url }}">{{ post.data.title | default(post.fileSlug) }}</a>
                </li>
                {% endfor %}
            </ul>
        </li>
        {% endfor %}
    </ul>
    <div class="gap" id="gapBottom"></div>


</div>